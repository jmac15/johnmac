			});
		</script> 

<!--FitText - Responsive Text - Dynamically fit text within it's container - https://github.com/davatron5000/FitText.js--> 
<script src="../js/jquery.fittext.js"></script> 
<script>
		  $(".fittext-menu").fitText(0.1);
		  $(".fittext-back").fitText(0.1);
		  $(".fittext-fwd").fitText(0.1); 
        </script> 
<script>
		$(function(){
			var pathname = (window.location.pathname.match(/[^\/]+$/)[0]);
			$('#sidr ul li a').each(function() {
			if ($(this).attr('href') == pathname)
			{
				$(this).addClass('current');
			}
			});
		});
		</script> 
<script> 
			$(document).ready(function(){
					$("#menu-inner").click(function(){
						$("#sticky-bits").toggle();
						$("#help").toggle();
						$(".left").toggleClass("right");
  						});
				  });
		</script> 
